import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
    public static void main (String[] args) throws java.lang.Exception
    {
        Scanner scanner = new Scanner(System.in);
        
        // Read input values for R, O, and C
        int r = scanner.nextInt();
        int o = scanner.nextInt();
        int c = scanner.nextInt();
        
        // Calculate remaining overs
        int remainingOvers = 20 - o;
        
        // Calculate maximum possible runs Team B can achieve
        int maxPossibleScore = c + (remainingOvers * 36);
        
        // Check if the maximum possible score is strictly greater than R
        if (maxPossibleScore > r) {
            System.out.println("YES");
        } else {
            System.out.println("NO");
        }
        
        scanner.close();
    }
}
