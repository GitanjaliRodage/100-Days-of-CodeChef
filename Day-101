import java.util.Scanner;

class Codechef {
    public static void main(String[] args) throws java.lang.Exception {
        Scanner scanner = new Scanner(System.in);
        
        if (!scanner.hasNextInt()) {
            return;
        }
        
        int n = scanner.nextInt();
        int cumulativeSum1 = 0;
        int cumulativeSum2 = 0;
        int maxLead = 0;
        int winner = 0;
        
        for (int i = 0; i < n; i++) {
            int score1 = scanner.nextInt();
            int score2 = scanner.nextInt();
            
            cumulativeSum1 += score1;
            cumulativeSum2 += score2;
            
            int currentLead = cumulativeSum1 - cumulativeSum2;
            
            // Check if Player 1 has the max lead so far
            if (currentLead > 0 && currentLead > maxLead) {
                maxLead = currentLead;
                winner = 1;
            }
            // Check if Player 2 has the max lead so far
            else if (currentLead < 0 && -currentLead > maxLead) {
                maxLead = -currentLead;
                winner = 2;
            }
        }
        
        System.out.println(winner + " " + maxLead);
        scanner.close();
    }
}
